# Application Environment
APP_ENV=development
APP_NAME=NyayaVault
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=nyayavault-dev-secret-change-in-production-minimum-32-chars

# Relational Database (PostgreSQL / Supabase / SQLite)
# SQLAlchemy uses the async engine, so the URL must use asyncpg.
DATABASE_URL=postgresql+asyncpg://nyayavault:nyayavault@localhost:5432/nyayavault
# For Supabase Cloud PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:kholnarepls@db.ctmjgcpdeltbbtpwvjsw.supabase.co:5432/postgres
# For local SQLite development fallback:
# DATABASE_URL=sqlite+aiosqlite:///./nyayavault.db

# JWT & Authentication Secrets
JWT_SECRET=nyayavault-jwt-secret-dev-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# Object Storage (MinIO / S3 / Local)
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=nyayavault-documents
STORAGE_REGION=us-east-1
STORAGE_SECURE=false
STORAGE_LOCAL_DIR=./storage_data

# Vector Database (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_DOCUMENTS=nyayavault_documents
QDRANT_COLLECTION_SECURITY=nyayavault_security
QDRANT_VECTOR_SIZE=384

# Task Queue & Broker (Redis)
REDIS_URL=redis://localhost:6379/0

# Integrity & Blockchain Layer
BLOCKCHAIN_MODE=mock
BLOCKCHAIN_NETWORK=nyayavault-network
BLOCKCHAIN_CHANNEL=nyayavault-channel
BLOCKCHAIN_CHAINCODE=nyayavault-integrity
INTEGRITY_SECRET_KEY=nyayavault-integrity-sha256-salt

# AI, OCR & Vector Embedding Engines
AI_MODE=mock                        # Options: mock, local, cloud
AI_CONFIDENCE_THRESHOLD=70          # Percentage (0-100) or decimal threshold
OCR_ENGINE=mock                     # Options: mock, tesseract, easyocr
AI_MODEL_PATH=./models
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SPACY_MODEL=en_core_web_sm

# External API Credentials & Services
OPENAI_API_KEY=
HUGGINGFACE_API_KEY=
SUPABASE_URL=https://ctmjgcpdeltbbtpwvjsw.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImN0bWpnY3BkZWx0YmJ0cHd2anN3Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODg3MTA4NjMsImV4cCI6MjEwNDI4Njg2M30.ANmaKs1BQnTTL87HIsfuEpKTwiZhILjX7n6JFVJxIFc

# CORS Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# File Upload Rules
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,doc,docx,jpg,jpeg,png,txt