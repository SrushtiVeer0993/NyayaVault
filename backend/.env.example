APP_ENV=development
APP_NAME=NyayaVault
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=nyayavault-dev-secret-change-in-production-minimum-32-chars

# Database
DATABASE_URL=postgresql+asyncpg://nyayavault:nyayavault@localhost:5432/nyayavault

# JWT
JWT_SECRET=nyayavault-jwt-secret-dev-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Storage (MinIO)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=nyayavault-documents
STORAGE_REGION=us-east-1
STORAGE_SECURE=false

# Blockchain (Mock/Hyperledger Fabric)
BLOCKCHAIN_MODE=mock
BLOCKCHAIN_NETWORK=nyayavault-network
BLOCKCHAIN_CHANNEL=nyayavault-channel
BLOCKCHAIN_CHAINCODE=nyayavault-integrity

# AI/OCR
AI_MODE=mock
AI_CONFIDENCE_THRESHOLD=70
OCR_ENGINE=mock
AI_MODEL_PATH=./models

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# File Upload
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,doc,docx,jpg,jpeg,png,txt
