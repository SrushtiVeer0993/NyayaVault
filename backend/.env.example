# Application Environment
APP_ENV=development
APP_NAME=NyayaVault
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=your_secret_key_change_in_production_min_32_chars

# Relational Database (PostgreSQL / Supabase)
# SQLAlchemy uses the async engine, so the URL must use asyncpg.
DATABASE_URL=postgresql+asyncpg://<DB_USER>:<DB_PASSWORD>@localhost:5432/<DB_NAME>
# For Supabase Cloud PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://<SUPABASE_USER>:<SUPABASE_PASSWORD>@<SUPABASE_HOST>:5432/postgres

# JWT & Authentication Secrets
JWT_SECRET=your_jwt_secret_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# Object Storage (MinIO / S3)
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=your_minio_access_key
STORAGE_SECRET_KEY=your_minio_secret_key
STORAGE_BUCKET=nyayavault-documents
STORAGE_REGION=us-east-1
STORAGE_SECURE=false


# Vector Database (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_api_key_optional
QDRANT_COLLECTION_DOCUMENTS=nyayavault_documents
QDRANT_COLLECTION_SECURITY=nyayavault_security
QDRANT_VECTOR_SIZE=384

# Task Queue & Broker (Redis)
REDIS_URL=redis://localhost:6379/0

# Integrity & Blockchain Layer
BLOCKCHAIN_MODE=mock
BLOCKCHAIN_NETWORK=nyayavault-network
BLOCKCHAIN_CHANNEL=nyayavault-channel
BLOCKCHAIN_CHAINCODE=nyayavault-integrity
INTEGRITY_SECRET_KEY=your_integrity_sha256_salt_secret

# AI, OCR & Vector Embedding Engines
AI_MODE=mock                        # Options: mock, local, cloud
AI_CONFIDENCE_THRESHOLD=70          # Percentage (0-100) or decimal threshold
OCR_ENGINE=mock                     # Options: mock, tesseract, easyocr
AI_MODEL_PATH=./models
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SPACY_MODEL=en_core_web_sm

# External API Credentials & LLM Services
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=your_openai_api_key_here
SUPABASE_URL=https://<your-supabase-project-ref>.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here


# CORS Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# File Upload Rules
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,doc,docx,jpg,jpeg,png,txt